<!DOCTYPE html>
<html lang="en">

<head>

<meta charset="UTF-8">

<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>JMB AI Chat</title>

<link rel="stylesheet" href="../css/chat.css">

</head>

<body>

<div class="chat-app">

    <!-- Header -->
    <header class="header">

        <button class="icon-btn" id="menuButton">☰</button>

        <div class="logo">
            🤖 JMB AI
        </div>

        <button class="icon-btn" id="settingsButton">⚙️</button>

    </header>

    <!-- Messages -->
    <main class="messages" id="chatMessages">

        <div class="message ai">

            <div class="avatar">🤖</div>

            <div class="bubble">

                <strong>JMB AI</strong>

                <p>Hello! 👋</p>

                <p>How can I help you today?</p>

            </div>

        </div>

    </main>

    <!-- Input -->
    <footer class="chat-input">

        <button class="tool-btn">📎</button>

        <button class="tool-btn">🎤</button>

        <input
            id="messageInput"
            type="text"
            placeholder="Ask JMB AI anything..."
        >

        <button id="sendButton" class="send-btn">

            ➤

        </button>

    </footer>

</div>

<script src="../js/chat.js"></script>

</body>

</html>
